# Optional — overrides the Formspree endpoint the contact form posts to.
#
#   1. Create a free form at https://formspree.io
#   2. Copy your endpoint, e.g.  https://formspree.io/f/abcdwxyz
#   3. Copy this file to `.env.local`, paste the endpoint below and rebuild.
#
# If left empty, the form uses the default endpoint set in src/data/profile.ts.

VITE_FORMSPREE_ENDPOINT=
